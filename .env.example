# Скопируйте этот файл в .env и меняйте значения при необходимости.
# Все строки необязательны — без .env используются значения по умолчанию.

# Движок моделей: ollama (основной) или llamacpp
LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
LLAMACPP_URL=http://127.0.0.1:8080

# Модель по умолчанию и размер контекста (8192 безопасно для 8 ГБ VRAM)
DEFAULT_MODEL=qwen3:8b
NUM_CTX=8192

# Сколько Ollama держит модель в видеопамяти после последнего запроса
KEEP_ALIVE=30m

# Адрес нашего сервера. 127.0.0.1 — доступ только с этого компьютера.
HOST=127.0.0.1
PORT=8000
